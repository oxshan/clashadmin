# 后台登录密码（至少 8 位，必填）。复制为 .env 后修改，或直接设置同名环境变量。
# 含特殊字符（如 $ # 空格）时请用单引号包起来：ADMIN_PASSWORD='p@$$w0rd'
ADMIN_PASSWORD=

# 以下为可选项，仅 Docker 部署（./start.sh）时生效：
# 对外访问地址，配置后 Clash、小火箭两条订阅链接和二维码都统一使用它，例如 https://sub.example.com
# PUBLIC_URL=
# 映射到宿主机的端口，默认 8787
# PORT=8787
# 监听的宿主机地址，默认 0.0.0.0；放在反向代理后面时建议改为 127.0.0.1
# BIND=127.0.0.1
# 从链接导入 YAML 时默认禁止访问本机和内网地址；确实需要（例如本机的订阅转换服务）时设为 1
# IMPORT_ALLOW_PRIVATE=1
